{
    "name": "portal",
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "deploy": "pnpm build && wrangler deploy",
        "deploy:check": "pnpm build && wrangler deploy --dry-run",
        "type-check": "vue-tsc --noEmit",
        "entries:env": "node scripts/entries-env.mjs",
        "format": "prettier --write src"
    },
    "dependencies": {
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/space-grotesk": "^5.3.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "vite": "^8.3.6",
        "vue-tsc": "^3.3.14",
        "wrangler": "^4.158.0"
    }
}
