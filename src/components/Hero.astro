---
import { t, tCount } from "@/i18n/t";
import type { HostGroup } from "@/lib/entries/model";

interface Props {
  groups: HostGroup[];
}

const { groups } = Astro.props;
---

<section class="hero">
  <h1>
    portal<span class="slash">/</span>
  </h1>
  <!-- The output of `tree`: one line per host, linking to its panel -->
  <nav aria-label={t("hero.tree")}>
    <ul class="tree">
      {groups.map((group) => (
        <li>
          <a href={`#${group.id}`}>
            <span class="host" data-tree-host>
              {group.host}
            </span>
            <span class="leader" aria-hidden="true" />
            <span class="count" data-tree-count>
              <span aria-hidden="true">{group.services.length}</span>
              <span class="visually-hidden">
                {tCount("count.services", group.services.length)}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <p class="tagline">{t("hero.tagline")}</p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-3-5);
  }

  h1 {
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .slash {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .tree {
    max-width: var(--tree-max);
    font-size: var(--text-name);
  }

  li {
    display: flex;
    white-space: nowrap;
  }

  /* The branches are drawing, so they stay out of the text */
  li::before {
    content: "├── ";
    color: var(--color-text-muted);
    white-space: pre;
  }

  li:last-child::before {
    content: "└── ";
  }

  a {
    display: flex;
    flex: 1;
    gap: 1ch;
    min-width: 0;
    color: var(--color-text-highlight);
    text-decoration: none;
  }

  .host {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (hover: hover) {
    a:hover .host {
      text-decoration: underline;
    }
  }

  /*
   * Dot leaders, one per character cell, centred on the line. They start
   * from the count's side, so the dots of every line fall in the same columns
   */
  .leader {
    flex: 1 0 2ch;
    background: radial-gradient(
        circle,
        var(--color-text-muted) 0.07em,
        transparent 0.09em
      )
      right center / 1ch 1lh repeat-x;
  }

  .count {
    color: var(--color-accent);
  }

  .tagline {
    font-size: var(--text-tagline);
    font-weight: 500;
    line-height: var(--leading-tight);
  }
</style>
