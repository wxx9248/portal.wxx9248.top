---
import type { HostGroup } from "@/lib/entries/model";
import ServiceTile from "@/components/ServiceTile.astro";
import { t } from "@/i18n/t";

interface Props {
  group: HostGroup;
}

const { group } = Astro.props;
const nameId = `${group.id}-name`;
const total = group.services.length;
---

<section class="panel" id={group.id} data-host-panel aria-labelledby={nameId}>
  <h2>
    <span class="host" id={nameId}>
      {group.host}
    </span>
    <span class="separator" aria-hidden="true">
      {t("separator")}
    </span>
    <span class="count" data-host-count>
      {total}
    </span>
  </h2>
  <ul class="tiles">
    {group.services.map((service) => (
      <ServiceTile service={service} />
    ))}
  </ul>
</section>

<style>
  .panel {
    position: relative;
    padding: var(--panel-padding);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius);
    /* Room for the title above the border when the hero's tree jumps here */
    scroll-margin-top: var(--space-8);
  }

  .panel:target {
    border-color: var(--color-accent);
  }

  /* The title sits in the top border, on the page colour to cut it */
  h2 {
    position: absolute;
    top: -0.85em;
    left: var(--space-3);
    display: flex;
    gap: 1ch;
    max-width: calc(100% - 2 * var(--space-3));
    padding: 0 var(--space-2);
    overflow: hidden;
    background: var(--color-bg-page);
    color: var(--color-text-heading);
    font-size: var(--text-body);
    font-weight: 500;
    white-space: nowrap;
  }

  .host {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .separator,
  .count {
    color: var(--color-text-muted);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, var(--tile-min)), 1fr)
    );
    gap: var(--space-3);
  }
</style>
