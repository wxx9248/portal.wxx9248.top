---
import type { Service } from "@/lib/entries/model";

interface Props {
  service: Service;
}

const { iconCandidates, monogram } = Astro.props.service;
const [firstCandidate] = iconCandidates;
---

<span class="icon" data-icon data-state="pending" aria-hidden="true">
  <span class="monogram">{monogram}</span>
  <img
    src={firstCandidate}
    data-candidates={JSON.stringify(iconCandidates)}
    alt=""
    width="32"
    height="32"
    decoding="async"
    referrerpolicy="no-referrer"
  />
</span>

<style>
  /*
   * The monogram shows until the icons script confirms an image loaded, so
   * pages without scripts and failed icons never show a broken image
   */
  .icon {
    position: relative;
    flex: none;
    width: var(--icon-size);
    height: var(--icon-size);
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius);
    color: var(--color-accent);
    font-size: var(--text-monogram);
    font-weight: 700;
    line-height: 1;
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    visibility: hidden;
  }

  .icon[data-state="loaded"] img {
    visibility: visible;
  }

  .icon[data-state="loaded"] .monogram {
    visibility: hidden;
  }
</style>
