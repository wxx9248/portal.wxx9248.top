---
import "@/styles/global.css";
import { headScript } from "@/scripts/head";
import { site } from "@/config/site";

interface Props {
  // Adds the canonical URL; off for pages that aren't the portal itself
  canonical: boolean;
  description: string;
  title: string;
}

const { canonical, description, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={site.url} />}
    <script is:inline set:html={headScript} />
  </head>
  <body>
    <slot />
  </body>
</html>
