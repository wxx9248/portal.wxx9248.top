---
import Base from "@/layouts/Base.astro";
import PromptLine from "@/components/PromptLine.astro";
import StatusBar from "@/components/StatusBar.astro";
import { site } from "@/config/site";
import { t } from "@/i18n/t";
---

<Base
  canonical={false}
  description={t("meta.description")}
  title={`${t("notFound.title")} · ${t("meta.title")}`}
>
  <PromptLine command={t("notFound.command")} />
  <main class="page">
    <h1>{t("notFound.title")}</h1>
    <p class="message">{t("notFound.message")}</p>
    <p>
      <a href="/">{t("notFound.back")}</a>
    </p>
  </main>
  <StatusBar label={site.host} />
</Base>

<style>
  h1 {
    font-size: var(--text-tagline);
    font-weight: 500;
  }

  .message {
    color: var(--color-text-secondary);
  }
</style>
