/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal",
  "compatibility_date": "2026-10-23",
  /**
   * Static Assets
   * Assets-only Worker: no script runs, so requests are not billed as Worker invocations.
   * The directory is Vite's build output, so run `pnpm build` before deploying.
   * Unknown paths fall back to index.html, matching the old Pages behaviour.
   * https://developers.cloudflare.com/workers/static-assets/
   */
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "portal.wxx9248.top",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}
